# Anthropic API key для AI-аналізу (секції B, C дайджесту)
ANTHROPIC_API_KEY=sk-ant-...

# Telegram Bot — для щоденної відправки звітів
# Створити бота: @BotFather → /newbot → отримати токен
# Дізнатись chat_id: надіслати боту повідомлення, потім відкрити
# https://api.telegram.org/bot<TOKEN>/getUpdates → знайти "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (Опціонально) Google OAuth для вивантаження у Google Sheets/Slides
# GOOGLE_SHEETS_ID=
# GOOGLE_SLIDES_ID=
